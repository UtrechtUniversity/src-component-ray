{% if _ray_head_node %}
# Head node setup
RAY_DASHBOARD_HOST="{{ find_private_network.stdout }}"

{% else %}

# Worker node setup

{% if (_ray_head_node_address | length) > 0 %}
{% if not ":" in _ray_head_node_address %}
RAY_ADDRESS="{{ _ray_head_node_address }}:{{ _ray_head_node_port }}"
RAY_DASHBOARD_HOST="{{ _ray_head_node_address }}"
{% else %}
RAY_ADDRESS="{{ _ray_head_node_address }}"
RAY_DASHBOARD_HOST="{{ _ray_head_node_address | split(':') | first }}"
{% endif %}
{% endif %}

{% endif %}

# Common setup
RAY_NODE_IP_ADDRESS="{{ find_private_network.stdout }}"
RAY_DASHBOARD_PORT="{{ _ray_dashboard_port }}"
RAY_CLIENT_SERVER_PORT="{{ _ray_client_server_port }}"
# todo: add storage location

{{ _ray_env | split(",") | join("\n") }}
